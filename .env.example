# Reference only: the service does not automatically load this file.
PRINT_MODE=simulate
PRINT_HOST=127.0.0.1
PRINT_PORT=8765
PRINT_RUNTIME=runtime
PRINT_PRINTER=TOSHIBA e-STUDIO2823AMSeries GDI
PRINT_SUMATRA=C:\Program Files\SumatraPDF\SumatraPDF.exe
PRINT_MAX_UPLOAD_MB=25
PRINT_TIMEOUT_SECONDS=120
PRINT_RETENTION_HOURS=24

# Optional IPP endpoint for native macOS printing
PRINT_IPP_ENABLED=0
